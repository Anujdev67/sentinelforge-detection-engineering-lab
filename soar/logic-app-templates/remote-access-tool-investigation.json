{
  "artifact_type": "logic-app-pseudodeployment",
  "artifact_version": "1.0.0",
  "name": "sentinelforge-remote-access-tool-investigation",
  "deployable": false,
  "simulation_notice": "Architecture reference only. It does not isolate devices or stop processes.",
  "trigger": {"connector": "Microsoft Sentinel", "event": "incident-created"},
  "approval_gate": {"required": true, "separation_of_duties": true, "before": "any-containment-branch"},
  "steps": [
    {"order": 1, "connector": "Microsoft Sentinel", "operation": "get-host-and-process-entities", "mode": "read-only"},
    {"order": 2, "connector": "Microsoft Defender XDR", "operation": "get-device-timeline-and-file-profile", "mode": "read-only"},
    {"order": 3, "connector": "Approvals", "operation": "request-human-device-containment-decision", "mode": "approval"},
    {"order": 4, "connector": "Microsoft Sentinel", "operation": "add-evidence-and-recommendation", "mode": "write-incident-only"}
  ],
  "forbidden_actions": ["isolate-device", "stop-process", "quarantine-file"],
  "audit": {"record_actor": true, "record_decision": true, "record_connector_result": true}
}
