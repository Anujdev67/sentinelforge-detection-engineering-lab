# Local-only SentinelForge configuration. Copy to .env; never commit .env.
SENTINELFORGE_ENV=development
SENTINELFORGE_DEMO_MODE=true
SENTINELFORGE_DATABASE_URL=postgresql+psycopg://sentinelforge:change-me-locally@db:5432/sentinelforge_demo
SENTINELFORGE_CORS_ORIGINS=http://localhost:5173
SENTINELFORGE_API_URL=http://localhost:8000
SENTINELFORGE_LOG_LEVEL=INFO

# Threat-intelligence lookups are deterministic and local by default.
# Set LIVE_REPUTATION_ENABLED=true only after reviewing data-sharing terms.
SENTINELFORGE_LIVE_REPUTATION_ENABLED=false
SENTINELFORGE_REPUTATION_CACHE_TTL_MINUTES=60
SENTINELFORGE_REPUTATION_TIMEOUT_SECONDS=8
SENTINELFORGE_VIRUSTOTAL_API_KEY=
SENTINELFORGE_ABUSEIPDB_API_KEY=
SENTINELFORGE_GREYNOISE_API_KEY=

# Local database only. Docker Compose reads these values.
POSTGRES_DB=sentinelforge_demo
POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=change-me-locally

# No Azure credentials are required or accepted by the local demo.
# Terraform examples use input variables only and must never be applied by project commands.

