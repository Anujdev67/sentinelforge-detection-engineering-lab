{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelforge.example/schemas/expected-alert.schema.json",
  "title": "SentinelForge expected detection alert",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "alert_count", "evidence_event_ids", "entities"],
  "properties": {
    "rule_id": { "type": "string", "pattern": "^SF-[0-9]{3}$" },
    "alert_count": { "type": "integer", "minimum": 1 },
    "evidence_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^evt-[a-z0-9-]{8,64}$" }
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}

