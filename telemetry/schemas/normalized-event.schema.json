{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelforge.example/schemas/normalized-event.schema.json",
  "title": "SentinelForge normalized synthetic event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "timestamp", "event_source", "event_type", "host", "user",
    "source_ip", "destination_ip", "action", "result", "correlation_id",
    "raw_event_ref", "normalized"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt-[a-z0-9-]{8,64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_source": {
      "enum": [
        "SigninLogs", "AuditLogs", "SecurityEvent", "DeviceProcessEvents",
        "DeviceNetworkEvents", "DeviceLogonEvents", "CommonSecurityLog",
        "OfficeActivity", "AzureActivity", "AWSCloudTrail", "GuardDuty"
      ]
    },
    "event_type": { "type": "string", "minLength": 2 },
    "host": { "type": "string", "minLength": 2 },
    "user": { "type": "string", "minLength": 2 },
    "source_ip": { "type": ["string", "null"], "format": "ip-address" },
    "destination_ip": { "type": ["string", "null"], "format": "ip-address" },
    "action": { "type": "string", "minLength": 2 },
    "result": { "type": "string", "minLength": 2 },
    "correlation_id": { "type": "string", "pattern": "^corr-[a-z0-9-]{6,64}$" },
    "raw_event_ref": { "type": "string", "pattern": "^synthetic://[a-z0-9/_-]+$" },
    "normalized": { "type": "object" }
  }
}

